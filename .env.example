# ---------------------------------------------------------------------------
# Notion → Google Drive backup — configuration template
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
# `.env` is git-ignored. NEVER put real secrets in this example file.
# In GitHub Actions, these same names are supplied as repository Secrets.
# ---------------------------------------------------------------------------

# --- Notion -----------------------------------------------------------------
# Internal Integration Secret from https://www.notion.so/my-integrations
# (starts with "ntn_" or the older "secret_").
NOTION_API_KEY=ntn_replace_me

# OPTIONAL FILTERS. Leave both blank to back up EVERYTHING the connection can
# see (recommended): grant access in Notion → connection → Content access.
# If set, only these databases / pages (and everything under them) are exported.
# Accepts 32-char IDs, dashed IDs, or full Notion URLs, comma-separated.
NOTION_DATABASE_IDS=
NOTION_PAGE_IDS=

# --- Google Drive -----------------------------------------------------------
# Folder ID from the Drive URL: https://drive.google.com/drive/folders/<FOLDER_ID>
# Use a Shared Drive (or a folder inside one). Add the service account's
# email to that Shared Drive as a Content manager.
GDRIVE_FOLDER_ID=

# Local runs: path to the downloaded service-account key file.
# Keep the key OUTSIDE the repo if you can, or inside ./secrets/ (git-ignored).
GDRIVE_SERVICE_ACCOUNT_FILE=./secrets/service-account.json

# CI runs: the full JSON contents of the key, pasted as one GitHub Secret.
# If set, this takes precedence over GDRIVE_SERVICE_ACCOUNT_FILE.
# Leave blank locally.
GDRIVE_SERVICE_ACCOUNT_JSON=

# --- Output -----------------------------------------------------------------
# Where Markdown is written before upload (and the only output in --dry-run).
OUTPUT_DIR=./dist
